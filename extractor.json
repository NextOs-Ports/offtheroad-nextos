{
  "schema": 1,
  "id": "offtheroad-nextos",
  "version": "1.18.2-arm64-3",
  "title": "OFF THE ROAD",
  "abi_order": [
    "arm64-v8a"
  ],
  "input": {
    "search_dirs": [
      "gamedata",
      "."
    ],
    "prefer_first_nonempty": true,
    "sniff_all_in_primary": true,
    "max_files": 64,
    "max_bundle_apks": 64,
    "max_member_bytes": 3221225472,
    "max_bundle_bytes": 6442450944,
    "packages": [
      "com.dogbytegames.offtheroad"
    ]
  },
  "extract": [
    {
      "id": "engine-libgame-arm64",
      "comment": "Sem sha256/tamanho exato de proposito: builds diferentes da mesma 1.18.2 (Play split, APK solto, regional) variam byte a byte. O contrato e' estrutural: ELF da ABI certa dentro da faixa.",
      "source": {
        "kind": "entry",
        "patterns": [
          "lib/{abi}/libgame.so"
        ]
      },
      "destination": "lib/libgame.so",
      "validate": {
        "type": "file",
        "elf_machine": "{abi}",
        "min_size": 4000000,
        "max_size": 64000000
      }
    },
    {
      "id": "android-libcpp-shared-arm64",
      "source": {
        "kind": "entry",
        "patterns": [
          "lib/{abi}/libc++_shared.so"
        ]
      },
      "destination": "lib/libc++_shared.so",
      "validate": {
        "type": "file",
        "elf_machine": "{abi}",
        "min_size": 400000,
        "max_size": 8000000
      }
    },
    {
      "id": "game-data-assets",
      "comment": "A engine abre os dados por AAssetManager_open, e o shim do loader serve isso a partir de ./assets/. A arvore assets/ do APK cai em assets/ com o prefixo removido: os data_%03d.xpk (~520 MB), a musica .ogg e, quando a build traz, AVConfig.json e ad-viewer/. So data_001.xpk e' requisito: a QUANTIDADE de xpk, o AVConfig.json (config de ads) e os .js variam por build, e o shim devolve NULL para asset ausente (mesma semantica do Android).",
      "source": {
        "kind": "entries",
        "patterns": [
          "assets/**"
        ],
        "strip_prefix": "assets/"
      },
      "destination": "assets",
      "validate": {
        "type": "tree",
        "min_files": 12,
        "max_files": 400,
        "min_bytes": 300000000,
        "max_bytes": 2000000000,
        "required_paths": [
          "data_001.xpk"
        ]
      }
    }
  ],
  "validate": [
    {
      "path": "lib/libgame.so",
      "type": "file",
      "elf_machine": "{abi}",
      "min_size": 4000000,
      "max_size": 64000000
    },
    {
      "path": "lib/libc++_shared.so",
      "type": "file",
      "elf_machine": "{abi}",
      "min_size": 400000,
      "max_size": 8000000
    },
    {
      "path": "assets/data_001.xpk",
      "type": "file",
      "min_size": 1000000,
      "max_size": 500000000
    },
    {
      "path": "assets",
      "type": "tree",
      "min_files": 12
    }
  ],
  "commit": [
    "lib",
    "assets"
  ],
  "compatibility": {
    "package_families": [
      "com.dogbytegames.offtheroad"
    ],
    "abis": [
      "arm64-v8a"
    ],
    "required_members": [
      {
        "member": "lib/arm64-v8a/libgame.so",
        "role": "variant_required",
        "variant": "arm64-v8a"
      },
      {
        "member": "lib/arm64-v8a/libc++_shared.so",
        "role": "variant_required",
        "variant": "arm64-v8a"
      },
      {
        "member": "assets/data_001.xpk",
        "role": "core_required"
      },
      {
        "member": "assets/AVConfig.json",
        "role": "optional"
      }
    ]
  }
}
