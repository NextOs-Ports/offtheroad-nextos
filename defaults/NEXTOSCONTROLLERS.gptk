# NEXTOSCONTROLLERS — controles editáveis / editable controls
# Formato próprio do NextOS; nunca vira teclado.
# NextOS-native format; never converted to keyboard input.

format = NEXTOS_CONTROLLERS/1
port = offtheroad

[menu]
A = otr.confirm
B = otr.back
START = otr.pause
RIGHT_STICK = cursor.move
R3 = cursor.click

[gameplay]
A = otr.accelerate
B = otr.brake
START = otr.pause
LEFT_STICK = camera.steer
RIGHT_STICK = camera.look

[cursor]
A = otr.confirm
B = otr.back
START = otr.pause
RIGHT_STICK = cursor.move
R3 = cursor.click

# Polished right-stick menu pointer: radial deadzone, progressive response,
# smoothing and frame-time-based motion are executed by nxinput 0.5.1.
speed = 1.25
deadzone = 0.15
response_curve = 1.35
acceleration = 0.35
smoothing_ms = 45

# The game already owns its camera tuning. NextOS routes the vector exactly
# once but does not apply a second curve/deadzone/sensitivity transform.
[camera]
authority = native
